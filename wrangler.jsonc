{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odepaula-projetos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Variáveis públicas (não sensíveis) do Worker. NÃO coloque
  // NEXTAUTH_SECRET aqui — segredos vão via `wrangler secret put`
  // (ou pelo painel: Workers & Pages > odepaula-projetos > Settings >
  // Variables and Secrets), nunca em texto puro neste arquivo, já que
  // ele normalmente vai parar num repositório Git.
  "vars": {
    "NEXTAUTH_URL": "https://odepaula-projetos.trimegisto.workers.dev",
    "NEXT_PUBLIC_SITE_URL": "https://odepaula-projetos.trimegisto.workers.dev"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "95f4e3cc50df4d70ab7364a40eccc45c",
      "localConnectionString": "postgresql://postgres.vfzrzkfzrvedejvbwrjw:vWTlcZpw2ej0rSzG@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
    }
  ]
}
