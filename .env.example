# ==========================================================
# O De Paula Program — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA cometa o arquivo ".env" real no controle de versão.
# ==========================================================

# --- Banco de dados -----------------------------------------------------
# PostgreSQL (recomendado). Pode ser um Postgres próprio ou Supabase.
# Formato Supabase (Connection Pooling, recomendado para serverless/Vercel):
# DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Formato Postgres tradicional:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/odepaula?schema=public"

# --- NextAuth -------------------------------------------------------------
# Gere um valor aleatório forte com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-forte"
# URL pública onde o site roda (produção: https://seudominio.com)
NEXTAUTH_URL="http://localhost:3000"

# --- Site -------------------------------------------------------------
# URL pública usada para gerar links, QR Codes e metadados de SEO/OG
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Primeiro administrador (usado pelo script prisma/seed.ts) -----------
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@odepaulaprogram.com"
ADMIN_PASSWORD="TrocarEssaSenha123!"
